{
  "name": "onnxruntime-c",
  "version": "1.28.0",
  "authors": {
    "ONNX Runtime": "onnxruntime@microsoft.com"
  },
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "homepage": "https://github.com/masicai/onnxruntime-swift-package-manager",
  "source": {
    "http": "https://github.com/masicai/onnxruntime-swift-package-manager/releases/download/1.28.0/onnxruntime-libs-1.28.0.zip",
    "sha256": "7e031979787f2da0f3ff45d18431db93c4443033020b210413b287a855870c3c"
  },
  "summary": "ONNX Runtime C/C++ Pod",
  "platforms": {
    "osx": "14.0"
  },
  "prepare_command": "mkdir -p Headers lib && cp onnxruntime.xcframework/macos-arm64_x86_64/Headers/onnxruntime/*.h Headers/ && cp onnxruntime.xcframework/macos-arm64_x86_64/libonnxruntime-macos.a lib/libonnxruntime.a",
  "static_framework": true,
  "weak_frameworks": [
    "CoreML"
  ],
  "source_files": "Headers/*.h",
  "preserve_paths": [
    "LICENSE",
    "lib/libonnxruntime.a"
  ],
  "description": "ONNX Runtime 1.28.0's C/C++ library, from the masicai/onnxruntime-swift-package-manager release (download.onnxruntime.ai is gone).",
  "libraries": "c++",
  "pod_target_xcconfig": {
    "OTHER_CPLUSPLUSFLAGS": "-fvisibility=hidden -fvisibility-inlines-hidden"
  },
  "vendored_libraries": "lib/libonnxruntime.a"
}
